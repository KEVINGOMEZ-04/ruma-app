# ==============================================================================
# ruma — Variables de entorno (copia a `.env.local` para desarrollo / build)
# Nunca subas `.env.local` ni llaves privadas al repositorio.
# ==============================================================================

# 1. Firebase (Plan Spark gratuito)
# Obtener en Firebase Console -> Configuración del proyecto -> Tus apps (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=luma-f53ee
VITE_FIREBASE_DATABASE_URL=https://luma-f53ee-default-rtdb.firebaseio.com
VITE_FIREBASE_ROOT_PATH=ruma_cloud_v1

# 2. Cloudflare Worker Backend (Plan Gratis: 100k req/día)
# URL tras ejecutar `cd worker && npx wrangler deploy`
VITE_BACKEND_API_URL=

# 3. Google OAuth 2.0 (Web + Android app.ruma.social)
VITE_GOOGLE_CLIENT_ID=419243559314-jriep6ork2h3o44ht83r5fe20ekpi3io.apps.googleusercontent.com
VITE_GOOGLE_ANDROID_CLIENT_ID=

# 4. RevenueCat / Google Play Billing v8+ (Gratis hasta $2,500 MTR)
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_ENTITLEMENT_ID=ruma_plus

# 5. Solo desarrollo local sin Cloudflare Worker (NO usar en APK de producción)
VITE_TMDB_API_KEY=
