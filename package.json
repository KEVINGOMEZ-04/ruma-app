{
  "name": "ruma-app",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "ruma — Santuario digital privado para grupos: recuerdos en Google Drive, club de cine/series/música, perfil estilo Discord y chat contextual.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint src tests worker/src",
    "test": "vitest run",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "security:purge-dry": "node scripts/purge-plaintext-passwords.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.7.13",
    "@revenuecat/purchases-capacitor": "^15.0.0",
    "canvas-confetti": "^1.9.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "eslint": "^9.39.5",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
